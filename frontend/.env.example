# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rightjobs?schema=public"

# Auth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
# Verified sender email - must be verified in your Resend account
EMAIL_FROM="Right Jobs <info@rightjob.net>"
SUPPORT_EMAIL="info@rightjob.net"

# AWS S3
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_ENABLED=false

# App Settings
NEXT_PUBLIC_APP_URL="https://rightjob.net"

# Cloudflare Turnstile
TURNSTILE_SECRET=""

# Search and analytics. The verification tokens are the content value only; the GA4 id looks like G-XXXXXXXXXX.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# A generated page (for example a job category) is offered to search engines only with at least this many
# open jobs from at least this many employers. Below that it still works but is noindex and left out of the sitemaps.
SEO_INDEX_MIN_JOBS=3
SEO_INDEX_MIN_EMPLOYERS=2

